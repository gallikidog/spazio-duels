<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>network.minespazio</groupId>
  <artifactId>spazioduels</artifactId>
  <version>1.2.9</version>
  <packaging>jar</packaging>

  <name>SpazioDuels</name>
  <description>Modulo de duelos y KOTH compatible con survival_core.</description>

  <properties>
    <java.version>21</java.version>
    <paper.version>1.21.10-R0.1-SNAPSHOT</paper.version>
    <worldedit.version>7.2.6</worldedit.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <project.build.outputTimestamp>2026-08-18T20:00:00Z</project.build.outputTimestamp>
    <survival.core.jar>C:/Users/Jhon/Documents/Codex/2026-07-07/pue/outputs/survival_core-0.9.66-SNAPSHOT.jar</survival.core.jar>
    <placeholderapi.jar>C:/Users/Jhon/Desktop/plugins/PlaceholderAPI-2.12.2.jar</placeholderapi.jar>
    <playerkits2.jar>C:/Users/Jhon/Desktop/Update + Survival/PlayerKits2-1.21.2.jar</playerkits2.jar>
    <bungeecord.chat.version>1.21-R0.2-deprecated+build.21</bungeecord.chat.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>enginehub</id>
      <url>https://maven.enginehub.org/repo/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.sk89q.worldedit</groupId>
      <artifactId>worldedit-bukkit</artifactId>
      <version>${worldedit.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.md-5</groupId>
      <artifactId>bungeecord-chat</artifactId>
      <version>${bungeecord.chat.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>network.minespazio</groupId>
      <artifactId>survival-core-api-runtime</artifactId>
      <version>0.9.66-SNAPSHOT</version>
      <scope>system</scope>
      <systemPath>${survival.core.jar}</systemPath>
    </dependency>
    <dependency>
      <groupId>me.clip</groupId>
      <artifactId>placeholderapi</artifactId>
      <version>2.12.2</version>
      <scope>system</scope>
      <systemPath>${placeholderapi.jar}</systemPath>
    </dependency>
    <dependency>
      <groupId>pk.ajneb97</groupId>
      <artifactId>playerkits2</artifactId>
      <version>1.21.2</version>
      <scope>system</scope>
      <systemPath>${playerkits2.jar}</systemPath>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${project.basedir}</sourceDirectory>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <release>${java.version}</release>
          <encoding>${project.build.sourceEncoding}</encoding>
          <proc>none</proc>
          <includes>
            <include>network/**/*.java</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

